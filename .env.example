# Firebase web SDK config — get from Firebase console:
# https://console.firebase.google.com -> Project Settings -> General -> Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# CometChat — get from https://app.cometchat.com
# Required for in-app messaging (M7). App works without these but chat is disabled.
EXPO_PUBLIC_COMET_CHAT_APP_ID=
EXPO_PUBLIC_COMET_CHAT_AUTH_KEY=
EXPO_PUBLIC_COMET_CHAT_REGION=us
